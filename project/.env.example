# Copy manually to .env and replace ALL placeholders, or run: python3 scripts/dev.py env
# KEY=value only; no shell quotes or expansions. Never commit .env.
JWT_SECRET=REPLACE_WITH_RANDOM_AT_LEAST_32_BYTES
INTERNAL_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARS
PG_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_LOCAL_ADMIN_PASSWORD
USER_DB_PASSWORD=REPLACE_WITH_RANDOM_USER_DB_PASSWORD
ITEM_DB_PASSWORD=REPLACE_WITH_RANDOM_ITEM_DB_PASSWORD
AUCTION_DB_PASSWORD=REPLACE_WITH_RANDOM_AUCTION_DB_PASSWORD
CLIENT_ORIGIN=http://localhost:8080
USER_DB_URL=jdbc:postgresql://localhost:55432/p5_user
USER_DB_USER=p5_user
ITEM_DB_URL=jdbc:postgresql://localhost:55432/p5_item
ITEM_DB_USER=p5_item
AUCTION_DB_URL=jdbc:postgresql://localhost:55432/p5_auction
AUCTION_DB_USER=p5_auction
ITEM_API_URL=http://localhost:8082
NOTIFICATION_API_URL=http://localhost:8084
# Optional: PG_BIN=/path/to/postgresql/bin
